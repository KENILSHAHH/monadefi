{
  "name": "@app/core",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./executors/*": "./src/executors/*.ts",
    "./guards": "./src/guards.ts",
    "./adapters/*": "./src/adapters/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "ingest": "tsx src/kb/ingest.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.79",
    "@app/perpl": "workspace:*",
    "@app/risk": "workspace:*",
    "@metamask/smart-accounts-kit": "^2.0.0",
    "@privy-io/node": "^0.35.0",
    "openai": "^7.32.0",
    "postgres": "^3.4.9",
    "viem": "^2.57.4",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
