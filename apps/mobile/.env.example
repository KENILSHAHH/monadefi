# Base URL of the Mona-DeFi API (apps/api). No trailing slash.
EXPO_PUBLIC_API_URL=https://api.3-83-183-92.sslip.io
# Relying party id of the passkeys: a domain that serves the two well-known files in apps/mobile/well-known/.
EXPO_PUBLIC_RP_ID=mona-defi.vercel.app
# Monad RPC for reads (the wallet nonce for the EIP-7702 authorization).
EXPO_PUBLIC_MONAD_RPC=https://rpc.monad.xyz
