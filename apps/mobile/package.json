{
  "name": "@app/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "5.2.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "@tanstack/react-query": "^5.104.2",
    "expo": "~57.0.28",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-passkey": "3.6.1",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "viem": "^2.57.5"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "node scripts/gen-fonts.mjs && expo run:ios",
    "android": "node scripts/gen-fonts.mjs && expo run:android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "expo-doctor",
    "export:ios": "node scripts/gen-fonts.mjs && expo export --platform ios",
    "export:web": "node scripts/gen-fonts.mjs && expo export --platform web",
    "prebuild": "node scripts/gen-fonts.mjs && expo prebuild --clean",
    "postinstall": "node scripts/gen-fonts.mjs",
    "fonts": "node scripts/gen-fonts.mjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|expo-.*|react-navigation|@react-navigation/.*|@category-labs/.*|@noble/.*|@scure/.*|viem|ox|abitype|@adraffy/.*))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
